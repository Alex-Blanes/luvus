---
// The luvus-notch showcase: an interactive replica of the macOS app, lifted out
// of the landing page so the docs can teach it. Same markup, styles and script;
// only the surrounding <section> and its heading were dropped so the widget
// drops into prose.
import IconClaudeCode from '../assets/icons/claudecode-color.svg';
import IconCodex from '../assets/icons/codex-color.svg';
import IconCopilot from '../assets/icons/githubcopilot.svg';
import IconOpencode from '../assets/icons/opencode.svg';

const cap = (s: string) => s[0].toUpperCase() + s.slice(1);

const NOTCH_AGENTS = [
  { id: 'claude', model: 'Sonnet 4.6', proj: 'sudos', state: 'blocked', cost: '0.67', ctx: 25, Icon: IconClaudeCode, slug: 'claudecode' },
  { id: 'codex', model: 'GPT-5', proj: 'esp-sol', state: 'working', cost: '1.20', ctx: 61, Icon: IconCodex, slug: 'codex' },
  { id: 'copilot', model: 'Claude', proj: 'notch', state: 'done', cost: '0.09', ctx: 12, Icon: IconCopilot, slug: 'copilot' },
  { id: 'opencode', model: 'Sonnet 4.6', proj: 'docs', state: 'idle', cost: '2.03', ctx: 88, Icon: IconOpencode, slug: 'opencode' },
];
---

<div class="macshow not-content">


      <div class="mac">
        <div class="screen">
          <div class="menubar">
            <span class="mb-l"><span class="mb-logo"></span> <b>luvus</b> <span class="mb-mi">File</span> <span class="mb-mi">View</span> <span class="mb-mi">Agents</span></span>
            <span class="mb-r">100%&nbsp;&nbsp;Tue&nbsp;9:41</span>
          </div>
          <div class="desk">
            <div class="termwin" id="termwin">
              <div class="tw-bar"><span class="tl r"></span><span class="tl y"></span><span class="tl g"></span><span class="tw-title" id="tw-title">claude · ~/sudos</span></div>
              <div class="tw-body">
                <div class="tw-side">
                  <div class="tw-slabel">Agents</div>
                  {NOTCH_AGENTS.map((a) => (
                    <button class="tw-agent" data-jump={a.id}><i class={`tsd ${a.state}`} data-sd={a.id}></i>{a.id}</button>
                  ))}
                </div>
                <div class="tw-pane" id="tw-pane"></div>
              </div>
            </div>
            <div class="jtoast" id="jtoast"></div>
          </div>

          <div class="island" id="island">
            <span class="ncamera"></span>
            <div class="ncollapsed">
              <span class="ncol-l"><i class="sumdot working" id="sumdot"></i><b id="sumcount">4</b></span>
              <span class="ncol-r"><span class="ndisc ic-claudecode"><IconClaudeCode /></span></span>
            </div>
            <div class="npanel" id="npanel">
              <div class="nview" id="nview-list">
                <div class="nhead"><span class="nhead-t">AGENTS</span><i class="ndot green"></i><span class="nspacer"></span><b>4</b></div>
                <div class="nrows">
                  {NOTCH_AGENTS.map((a) => (
                    <button class="nrow" data-jump={a.id}>
                      <span class={`ndisc ic-${a.slug}`}><a.Icon /></span>
                      <span class="nmodel">{a.model}</span>
                      <span class="nproj">{a.proj}</span>
                      <span class="nspacer"></span>
                      <span class="nctx"><span class="nctx-bar"><i class={a.ctx >= 85 ? 'red' : a.ctx >= 60 ? 'amber' : 'grn'} style={`width:${a.ctx}%`}></i></span><span class="nctx-n">{a.ctx}%</span></span>
                      <span class="ncost">${a.cost}</span>
                      <span class={`npill ${a.state}`} data-pill={a.id}>{cap(a.state)}</span>
                    </button>
                  ))}
                </div>
                <div class="nfoot">
                  <span class="fstat"><i class="ndot green"></i><b id="f-run">2</b> running</span>
                  <span class="fstat"><i class="ndot done"></i><b id="f-done">1</b> done</span>
                  <span class="fstat"><i class="ndot idle"></i><b id="f-idle">1</b> idle</span>
                  <span class="nspacer"></span><b class="ftotal">$3.99</b><span class="ftot-l">total</span>
                </div>
              </div>
              <div class="nview" id="nview-approve" hidden>
                <div class="ncard-head"><span class="ncard-hand">✋</span><b>claude</b><span class="nproj">sudos</span><span class="nspacer"></span><span class="ncard-open">⧉</span></div>
                <div class="ncard-ctx">Claude wants to run a command</div>
                <div class="ncard-q">Run <b>cargo&nbsp;test</b> in <b>sudos</b>?</div>
                <div class="ncard-opts">
                  <button class="nopt allow" data-answer="yes"><span class="nnum">1</span><span class="nopt-l">Yes</span><span class="nkey">⌘Y</span></button>
                  <button class="nopt" data-answer="always"><span class="nnum">2</span><span class="nopt-l">Yes, and don't ask again</span></button>
                  <button class="nopt deny" data-answer="no"><span class="nnum">3</span><span class="nopt-l">No, keep working</span><span class="nkey">⌘N</span></button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="caps" id="caps">
        <button class="cap on" data-cap="monitor"><b>Monitor</b><span>every agent, one glance</span></button>
        <button class="cap" data-cap="approve"><b>Approve</b><span>answer &amp; grant permission</span></button>
        <button class="cap" data-cap="jump"><b>Jump</b><span>focus its pane</span></button>
      </div>

      <div class="ms-foot">
        <code class="cask">brew install --cask --no-quarantine RizRiyz/luvus/luvus-notch</code>
        <span class="ms-req">macOS 15+ · Apple silicon · <a href="https://github.com/RizRiyz/luvus/releases">or download the .dmg</a></span>
      </div>
    
</div>

<style is:global>
      /* ── the luvus-notch macOS showcase (matches luvus-notch/) ── */
      .macshow { text-align: center; }
      .ms-title { font-size: clamp(1.7rem, 4vw, 2.1rem); margin-bottom: 0.8rem; }
      .ms-sub { color: var(--sub); max-width: 44rem; margin: 0 auto 2.6rem; font-size: 0.85rem; line-height: 1.8; }
      .ms-sub strong { color: var(--text); }
      .ms-sub b { color: var(--accent); font-weight: 600; }

      .mac { --amber: #ff9e0a; --grn: var(--accent); --done: #30d159; max-width: 860px; margin: 0 auto; }
      .screen {
        position: relative; aspect-ratio: 16 / 10; border-radius: 20px;  overflow: hidden;
        background: var(--bg);
      }
      .menubar {
        display: flex; justify-content: space-between; align-items: center;
        height: 26px; padding: 0 0.9rem; font-size: 0.7rem; color: rgb(255 255 255 / 0.55);
        background: rgb(0 0 0 / 0.35); border-bottom: 1px solid rgb(255 255 255 / 0.05);
      }
      .mb-l { display: flex; align-items: center; gap: 0.55rem; }
      .mb-l b { color: rgb(255 255 255 / 0.85); font-weight: 600; }
      .mb-mi { color: rgb(255 255 255 / 0.4); }
      .mb-logo { width: 9px; height: 9px; border-radius: 2px; background: var(--accent); }
      .mb-r { font-family: 'JetBrains Mono Variable', monospace; font-size: 0.66rem; }
      .desk {
        position: absolute; inset: 26px 0 0; padding: 2.6rem 1.6rem 1.6rem;
        background:
          radial-gradient(120% 95% at 10% 6%, rgb(255 126 182 / 0.85), transparent 42%),
          radial-gradient(120% 95% at 92% 10%, rgb(123 108 255 / 0.85), transparent 46%),
          radial-gradient(130% 100% at 82% 96%, rgb(34 211 170 / 0.8), transparent 48%),
          radial-gradient(120% 110% at 14% 100%, rgb(255 179 71 / 0.7), transparent 46%),
          linear-gradient(155deg, #3a2a63 0%, #1e2b52 46%, #123a3a 100%);
        display: flex; align-items: flex-end; justify-content: center;
      }
      .desk::after {
        content: ''; position: absolute; inset: 0; pointer-events: none;
        background: radial-gradient(140% 120% at 50% 0%, transparent 55%, rgb(0 0 0 / 0.35));
      }
      .termwin {
        position: relative; z-index: 1;
        width: 100%; max-width: 610px; height: 84%; display: flex; flex-direction: column;
        background: rgb(14 14 19 / 0.96);
        border: 1px solid rgb(255 255 255 / 0.12); border-radius: 10px;
        overflow: hidden; transition: box-shadow 0.2s;
      }
      .tw-bar { display: flex; align-items: center; gap: 0.4rem; padding: 0.45rem 0.7rem; border-bottom: 1px solid rgb(255 255 255 / 0.06); }
      .tw-title { margin-left: 0.5rem; font: 0.68rem 'JetBrains Mono Variable', monospace; color: rgb(255 255 255 / 0.6); }
      .tw-body { flex: 1; display: flex; min-height: 0; }
      .tw-side { width: 106px; flex-shrink: 0; border-right: 1px solid rgb(255 255 255 / 0.06); padding: 0.5rem 0.3rem; }
      .tw-slabel { font-size: 0.56rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(255 255 255 / 0.35); padding: 0.15rem 0.4rem 0.4rem; }
      .tw-agent {
        display: flex; align-items: center; gap: 0.4rem; width: 100%;
        background: none; border: 0; cursor: pointer; text-align: left; color: rgb(255 255 255 / 0.7);
        padding: 0.3rem 0.4rem;  font: 0.72rem 'JetBrains Mono Variable', monospace;
      }
      .tw-agent:hover { background: rgb(255 255 255 / 0.05); color: #fff; }
      .tw-agent.on { background: rgb(from var(--accent) r g b / 0.16); color: var(--accent); }
      .tsd { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
      .tsd.working { background: var(--grn); } .tsd.blocked { background: var(--amber); animation: pulse 1s infinite; }
      .tsd.done { background: var(--done); } .tsd.idle { background: var(--overlay0); }
      .tw-pane { flex: 1; padding: 0.6rem 0.85rem; font: 0.72rem/1.9 'JetBrains Mono Variable', monospace; overflow: hidden; }
      .tw-pane .tline { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--text); animation: rise 0.25s ease-out; }
      .jtoast {
        position: absolute; bottom: 1rem; left: 50%; transform: translateX(-50%) translateY(6px);
        background: rgb(from var(--accent) r g b / 0.14); color: var(--accent); border: 1px solid rgb(from var(--accent) r g b / 0.3);
        border-radius: 999px; padding: 0.28rem 0.9rem; font: 0.72rem 'JetBrains Mono Variable', monospace;
        opacity: 0; pointer-events: none; transition: opacity 0.2s, transform 0.2s; z-index: 8;
      }
      .jtoast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

      /* capability buttons */
      .caps { display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap; max-width: 860px; margin: 1.8rem auto 0; }
      .cap {
        display: flex; flex-direction: column; align-items: flex-start; gap: 0.1rem;
        background: var(--bg2); border: 1px solid var(--line);
        padding: 0.6rem 1rem; cursor: pointer; text-align: left; min-width: 158px;
        transition: border-color 0.15s, background 0.15s, transform 0.15s;
      }
      .cap:hover { border-color: rgb(from var(--accent) r g b / 0.45); transform: translateY(-2px); }
      .cap.on { border-color: var(--accent); background: var(--surface); }
      .cap b { font-family: 'IBM Plex Mono', monospace; font-size: 0.92rem; color: var(--text); }
      .cap.on b { color: var(--accent); }
      .cap span { font-size: 0.72rem; color: var(--sub); }

      .ms-foot { margin-top: 1.9rem; display: flex; flex-direction: column; align-items: center; gap: 0.6rem; }
      .ms-req { font-size: 0.8rem; color: var(--sub); }
      .ms-req a { color: var(--accent); }

      /* The island · one black element, top-anchored, that grows on open. */
      .island {
        position: absolute; top: 0; left: 50%; transform: translateX(-50%);
        width: 132px; height: 30px; background: #000; border-radius: 0 0 11px 11px;
        border: 0.5px solid rgb(255 255 255 / 0.08); border-top: 0;
         z-index: 20; overflow: hidden;
        transition: width 0.34s cubic-bezier(0.22, 1, 0.36, 1), height 0.34s cubic-bezier(0.22, 1, 0.36, 1);
      }
      /* Height is set from content by JS (sizeIsland) so the panel hugs each
         view · no dead space below the shorter approve card. */
      /* Capped to the screen it sits in: `.screen` clips overflow, so a flat
         372px would be trimmed on both sides once the mock is narrower. */
      .island.open { width: min(372px, 92%); border-radius: 0 0 22px 22px; }
      .ncamera {
        position: absolute; top: 8px; left: 50%; transform: translateX(-50%);
        width: 7px; height: 7px; border-radius: 50%;
        background: #050505; z-index: 5;
      }
      .island :is(.nmodel, .nproj, .nhead, .ncost, .nctx-n, .nopt, .ncard-q, .ncard-ctx, .fstat, .ftot-l) {
        font-family: 'Inter Variable', system-ui, sans-serif;
      }

      /* collapsed pill content · absolute so it never adds to the panel's
         measured height. */
      .ncollapsed {
        position: absolute; top: 0; left: 0; right: 0; z-index: 2;
        display: flex; align-items: center; justify-content: space-between;
        height: 30px; padding: 0 11px; opacity: 1; transition: opacity 0.12s;
      }
      .island.open .ncollapsed { opacity: 0; pointer-events: none; }
      .ncol-l { display: flex; align-items: center; gap: 5px; }
      .sumdot { width: 6px; height: 6px; border-radius: 50%; }
      .sumdot.blocked { background: var(--amber); animation: pulse 1s infinite; }
      .sumdot.working { background: var(--grn); animation: pulse 1.6s infinite; }
      .ncol-l b { font-size: 12px; font-weight: 600; color: #fff; }
      .ncol-r .ndisc { width: 16px; height: 16px; }

      /* expanded panel · in normal flow so its height drives the island. The
         top pad clears the notch bar; the bottom pad matches the real app. */
      .npanel {
        position: relative; padding: 34px 0 11px; opacity: 0;
        transition: opacity 0.2s 0.06s;
      }
      .island.open .npanel { opacity: 1; }
      .nview[hidden] { display: none; }

      .nhead {
        display: flex; align-items: center; gap: 6px; padding: 2px 16px 4px;
      }
      .nhead-t { font-size: 10px; font-weight: 700; letter-spacing: 1.6px; color: rgb(255 255 255 / 0.55); }
      .nhead b { font-size: 10px; font-weight: 600; color: rgb(255 255 255 / 0.55); }
      .ndot { width: 5px; height: 5px; border-radius: 50%; }
      .ndot.green { background: var(--accent); }
      .ndot.done { background: var(--done); }
      .ndot.idle { background: #7a7a82; }
      .nspacer { flex: 1; }

      .nrows { padding: 0 6px; }
      .nrow {
        display: flex; align-items: center; gap: 8px; width: 100%; padding: 5px 10px;
        background: none; border: 0; border-radius: 7px; text-align: left; cursor: pointer;
        transition: background 0.12s;
      }
      .nrow:hover { background: rgb(255 255 255 / 0.05); }
      .ndisc {
        width: 18px; height: 18px; flex-shrink: 0; color: #fff;
        display: flex; align-items: center; justify-content: center;
      }
      .ndisc svg { width: 100%; height: 100%; display: block; }
      .ndisc svg path { fill: currentColor; }
      .nmodel { font-size: 12px; font-weight: 600; color: #fff; white-space: nowrap; }
      .nproj { font-size: 11px; color: rgb(255 255 255 / 0.55); white-space: nowrap; }
      .nctx { display: flex; align-items: center; gap: 3px; }
      .nctx-bar { width: 26px; height: 3.5px; border-radius: 2px; background: rgb(255 255 255 / 0.12); overflow: hidden; }
      .nctx-bar i { display: block; height: 100%; border-radius: 2px; }
      .nctx-bar i.grn { background: var(--grn); }
      .nctx-bar i.amber { background: #ff9e0a; }
      .nctx-bar i.red { background: #f26b61; }
      .nctx-n { font-size: 8px; font-weight: 600; color: rgb(255 255 255 / 0.55); font-family: 'JetBrains Mono Variable', monospace; }
      .ncost { font-size: 10px; color: rgb(255 255 255 / 0.55); font-family: 'JetBrains Mono Variable', monospace; }
      .npill {
        font-size: 9px; font-weight: 600; padding: 2px 6px; border-radius: 999px; white-space: nowrap;
      }
      .npill.blocked { color: var(--amber); background: rgb(255 158 10 / 0.15); }
      .npill.working { color: var(--grn); background: rgb(from var(--accent) r g b / 0.15); }
      .npill.done { color: var(--done); background: rgb(48 209 89 / 0.15); }
      .npill.idle { color: var(--overlay1); background: rgb(154 154 162 / 0.13); }

      .nfoot {
        display: flex; align-items: center; gap: 12px; padding: 8px 16px 0;
      }
      .fstat { display: flex; align-items: center; gap: 4px; font-size: 10px; color: rgb(255 255 255 / 0.55); }
      .fstat b { color: #fff; font-weight: 600; }
      .ftotal { font-size: 10px; font-weight: 600; color: #fff; font-family: 'JetBrains Mono Variable', monospace; }
      .ftot-l { font-size: 9px; color: rgb(255 255 255 / 0.55); margin-left: 3px; }

      /* permission card · merged approve/answer view (real PermissionCardView) */
      #nview-approve { padding: 0 16px; }
      .ncard-head { display: flex; align-items: center; gap: 7px; padding-bottom: 8px; }
      .ncard-head b { font-size: 12px; font-weight: 600; color: #fff; }
      .ncard-hand { font-size: 12px; }
      .ncard-open { color: rgb(255 255 255 / 0.55); font-size: 12px; }
      .ncard-ctx { font-size: 10.5px; color: rgb(255 255 255 / 0.5); margin-bottom: 5px; }
      .ncard-q { font-size: 12.5px; font-weight: 600; color: #fff; line-height: 1.35; margin-bottom: 9px; }
      .ncard-q b { color: var(--accent); font-weight: 600; }
      .ncard-opts { display: flex; flex-direction: column; gap: 5px; }
      .nopt {
        display: flex; align-items: center; gap: 9px; width: 100%; text-align: left;
        padding: 7px 10px; border: 0; border-radius: 8px; cursor: pointer;
        background: rgb(255 255 255 / 0.06); color: #fff; font-size: 12px;
      }
      .nnum { font-family: 'JetBrains Mono Variable', monospace; font-size: 11px; font-weight: 700; width: 14px; color: rgb(255 255 255 / 0.55); }
      .nopt-l { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .nkey { font-size: 9px; color: rgb(255 255 255 / 0.5); }
      .nopt.allow { background: rgb(from var(--accent) r g b / 0.16); }
      .nopt.allow .nnum { color: var(--accent); }
      .nopt.allow:hover { background: rgb(from var(--accent) r g b / 0.26); }
      .nopt.deny { background: rgb(209 56 51 / 0.16); }
      .nopt.deny .nnum { color: #f26b61; }
      .nopt.deny:hover { background: rgb(209 56 51 / 0.26); }
      .nopt:not(.allow):not(.deny):hover { background: rgb(255 255 255 / 0.11); }

      /* Repo call to action */
      .cta-card {
        position: relative; overflow: hidden; text-align: center;
        max-width: 720px; margin: 0 auto;
        background: none;
        border: 1px solid var(--line);
        padding: 3.2rem 2rem 2.8rem;
      }
      /* Sits directly above the licence badge, centred, as the card's opener. */
      .cta-art {
        display: block; margin: 0 auto 1.4rem; width: 200px; height: auto;
        border-radius: 12px;
      }
      .cta-badge {
        display: inline-block; font: 0.72rem 'IBM Plex Mono', monospace; color: var(--accent);
        background: rgb(from var(--accent) r g b / 0.1); border: 1px solid rgb(from var(--accent) r g b / 0.25);
        padding: 0.3rem 0.85rem;  margin-bottom: 1.3rem;
      }
      .cta-card h2 { font-size: clamp(1.35rem, 3vw, 1.7rem); letter-spacing: -0.035em; margin: 0 0 0.9rem; }
      .cta-card p { color: var(--sub); max-width: 40rem; margin: 0 auto; font-size: 1.03rem; line-height: 1.62; }
      .cta-actions { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; margin-top: 1.9rem; }
      .cta-actions .btn { display: inline-flex; align-items: center; gap: 0.55rem; padding: 0.72rem 1.5rem; font-size: 0.98rem; transition: border-color 0.15s, filter 0.15s, transform 0.15s; }
      .cta-actions .btn:hover { transform: translateY(-2px); }
      .cta-ic { width: 18px; height: 18px; flex-shrink: 0; }
      .cta-mini {
        display: flex; gap: 0.7rem; justify-content: center; align-items: center; flex-wrap: wrap;
        margin-top: 1.7rem; font-size: 0.85rem; color: var(--sub);
      }

      /* This is a fixed-proportion replica: its panel is 372px and its labels
         are 9-12px, so squeezing it past a point stops it being legible.
         Below that, keep the geometry and scroll instead. */
      @media (max-width: 640px) {
        .macshow { overflow-x: auto; -webkit-overflow-scrolling: touch; padding-bottom: 0.5rem; }
        .mac, .caps { min-width: 520px; }
      }
      @media (max-width: 560px) {
        .cap { min-width: 0; flex: 1 1 9rem; }
        .ms-foot { flex-direction: column; gap: 0.5rem; align-items: flex-start; }
      }
</style>

<script>
      const $ = (id: string) => document.getElementById(id);
      const island = $('island');
      if (island) {
        type Cap = 'monitor' | 'approve' | 'jump';

        // Terminal pane content per focused agent (+ special claude states).
        const PANE: Record<string, string[]> = {
          claude: [
            '<span class="c-dim">⏺</span> Reading <span class="c-acc">src/app/dispatch.rs</span>…',
            '<span class="c-grn">✓</span> Edit <span class="c-acc">src/app/mod.rs</span> <span class="c-dim">(+14 -3)</span>',
            '<span class="c-dim">⏺</span> Running <span class="c-acc">cargo test</span>… <span class="c-grn">143 passed</span>',
          ],
          'claude-approve': [
            '<span class="c-dim">⏺</span> Ready to run the test suite…',
            '<span class="c-amber">⏸ waiting · answer in the notch ↑</span>',
          ],
          'claude-done': [
            '<span class="c-dim">⏺</span> Running <span class="c-acc">cargo test</span>…',
            '<span class="c-grn">✓</span> 143 passed <span class="c-dim">· 2.1s</span>',
          ],
          codex: [
            '<span class="c-dim">⏺</span> Editing <span class="c-acc">firmware.rs</span>…',
            '<span class="c-dim">⏺</span> Flashing ESP32 <span class="c-dim">· 61% ctx</span>',
          ],
          copilot: [
            '<span class="c-grn">✓</span> Build finished <span class="c-dim">in 14s</span>',
            '<span class="c-mint">done · ready to review</span>',
          ],
          opencode: ['<span class="c-dim">idle · waiting for input</span>'],
        };
        const CWD: Record<string, string> = { claude: '~/sudos', codex: '~/esp-sol', copilot: '~/notch', opencode: '~/docs' };

        // The island height hugs whichever view is visible (no dead space).
        const sizeIsland = () => {
          if (island.classList.contains('open'))
            island.style.height = ($('npanel') as HTMLElement).scrollHeight + 'px';
        };
        const showView = (v: 'list' | 'approve') => {
          ($('nview-list') as HTMLElement).hidden = v !== 'list';
          ($('nview-approve') as HTMLElement).hidden = v !== 'approve';
          sizeIsland();
        };
        const setSummary = (blocked: boolean) => {
          const d = $('sumdot');
          if (d) d.className = 'sumdot ' + (blocked ? 'blocked' : 'working');
        };
        const setClaudePill = (state: string) => {
          const pill = document.querySelector('[data-pill="claude"]');
          if (pill) { pill.className = 'npill ' + state; pill.textContent = state.charAt(0).toUpperCase() + state.slice(1); }
          document.querySelector('[data-sd="claude"]')?.setAttribute('class', 'tsd ' + state);
          const foot = { work: 1, done: 1, idle: 1 };
          if (state === 'blocked' || state === 'working') foot.work += 1;
          else if (state === 'done') foot.done += 1; else foot.idle += 1;
          ($('f-run') as HTMLElement).textContent = String(foot.work);
          ($('f-done') as HTMLElement).textContent = String(foot.done);
          ($('f-idle') as HTMLElement).textContent = String(foot.idle);
        };

        // Focus a terminal pane (the "Jump" payoff): swap title/body, flash a ring.
        let focused = 'claude';
        const focusTerminal = (id: string, variant = '') => {
          focused = id;
          ($('tw-title') as HTMLElement).textContent = `${id} · ${CWD[id] ?? '~'}`;
          const lines = PANE[variant || id] ?? PANE[id] ?? [];
          const pane = $('tw-pane') as HTMLElement;
          pane.innerHTML = lines.map((l) => `<div class="tline">${l}</div>`).join('');
          document.querySelectorAll('.tw-agent').forEach((a) =>
            a.classList.toggle('on', a.getAttribute('data-jump') === id)
          );
          const win = $('termwin');
          win?.classList.remove('flash'); void win?.offsetWidth; win?.classList.add('flash');
        };
        const toast = (msg: string) => {
          const t = $('jtoast') as HTMLElement;
          t.textContent = msg; t.classList.add('show');
          setTimeout(() => t.classList.remove('show'), 1600);
        };

        // Open / close the notch. Hovering the screen opens it; leaving closes
        // it unless a click "pinned" it open for a beat (so a tap on a cap or a
        // card answer stays visible even with the cursor off the screen).
        let hovering = false, pinned = false;
        let pinT: ReturnType<typeof setTimeout> | undefined;
        let closeT: ReturnType<typeof setTimeout> | undefined;
        const openIsland = () => { island.classList.add('open'); sizeIsland(); };
        const closeIsland = () => { island.classList.remove('open'); island.style.height = ''; };
        const pin = (ms = 2600) => {
          pinned = true; clearTimeout(pinT);
          pinT = setTimeout(() => { pinned = false; if (!hovering) closeIsland(); }, ms);
        };
        const maybeClose = () => {
          clearTimeout(closeT);
          closeT = setTimeout(() => { if (!hovering && !pinned) closeIsland(); }, 240);
        };

        // The three capabilities.
        const setCap = (cap: Cap) => {
          setActiveCap(cap);
          if (cap === 'monitor') {
            showView('list'); setSummary(false); setClaudePill('working'); focusTerminal('claude');
          } else if (cap === 'approve') {
            showView('approve'); setSummary(true); setClaudePill('blocked'); focusTerminal('claude', 'claude-approve');
          } else if (cap === 'jump') {
            showView('list'); setSummary(false); setClaudePill('working');
            focusTerminal('copilot'); toast('Jumped to copilot');
          }
        };

        // Answering the card → Claude resumes; approve runs to Done, deny keeps
        // it working. Back to the Monitor view either way.
        const answer = (deny: boolean) => {
          setActiveCap('monitor'); showView('list'); setSummary(false);
          setClaudePill('working'); focusTerminal('claude');
          if (!deny) setTimeout(() => { setClaudePill('done'); focusTerminal('claude', 'claude-done'); }, 2200);
        };
        function setActiveCap(cap: Cap) {
          document.querySelectorAll('#caps .cap').forEach((c) =>
            c.classList.toggle('on', c.getAttribute('data-cap') === cap));
        }

        // Wiring — hover the Mac screen to reveal / hide the notch.
        const mac = document.querySelector('.mac');
        mac?.addEventListener('mouseenter', () => { hovering = true; openIsland(); });
        mac?.addEventListener('mouseleave', () => { hovering = false; maybeClose(); });

        $('caps')?.addEventListener('click', (e) => {
          const b = (e.target as HTMLElement).closest('[data-cap]');
          if (b) { setCap(b.getAttribute('data-cap') as Cap); openIsland(); pin(); }
        });
        $('nview-approve')?.addEventListener('click', (e) => {
          const b = (e.target as HTMLElement).closest('[data-answer]');
          if (b) { answer(b.getAttribute('data-answer') === 'no'); openIsland(); pin(); }
        });
        // Click any agent (notch row or terminal sidebar) to jump to its pane.
        document.querySelectorAll('[data-jump]').forEach((el) =>
          el.addEventListener('click', () => {
            const id = el.getAttribute('data-jump') as string;
            focusTerminal(id); toast(`Jumped to ${id}`);
            setActiveCap('jump'); openIsland(); pin();
          })
        );

        // Seed Monitor. On a plain load, peek the island open once so first-time
        // visitors see it drop from the notch (double-rAF paints collapsed first
        // so the transition animates), then it tucks away unless hovered. A
        // `?cap=approve|jump` deep-link opens it straight away, held open.
        const params = new URLSearchParams(location.search);
        const startCap = (params.get('cap') as Cap) || 'monitor';
        setCap(['monitor', 'approve', 'jump'].includes(startCap) ? startCap : 'monitor');
        setClaudePill('working');
        if (params.has('cap')) { openIsland(); pin(6e5); }
        else requestAnimationFrame(() => requestAnimationFrame(() => { openIsland(); pin(3400); }));
      }
</script>
