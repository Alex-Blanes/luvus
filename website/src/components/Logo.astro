---
// The Luvus mark. Every call site across the landing pages and docs resolves the
// surviving canonical SVG through here, so deleted legacy artwork cannot drift
// back into one surface.
//
// Same props as before (`width` / `height` / `class`), so no call site changed.
interface Props {
  width?: number;
  height?: number;
  class?: string;
  [key: string]: unknown;
}

import logoUrl from '../assets/luvus-logo.svg?url';

const { width = 32, height, class: className, ...rest } = Astro.props;
---

<img
  src={logoUrl}
  width={width}
  height={height ?? width}
  alt=""
  loading="eager"
  decoding="async"
  class:list={['bh-mark', className]}
  {...rest}
/>

<style>
  .bh-mark {
    /* The artwork is a full-bleed tile, so the corners have to be cut or it
       reads as a cropped screenshot. A percentage keeps the curve proportional
       at every size the mark is used at. */
    border-radius: 22%;
    object-fit: cover;
    display: block;
  }
</style>
